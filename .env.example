# LLM Provider: "openai" or "gemini"
LLM_PROVIDER=gemini

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Gemini Configuration (use GEMINI_API_KEYS for multiple keys)
GEMINI_API_KEYS=your-gemini-api-key-here
# Generation Configuration
NUM_SCTS_TO_GENERATE=5
MODEL=gemini-2.5-flash

# Diseases to generate (hepatocellular_carcinoma, icca)
DISEASES=hepatocellular_carcinoma,icca

# Logging
LOG_LEVEL=INFO
